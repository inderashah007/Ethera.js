// Import dependencies
const express = require('express');
const bodyParser = require('body-parser');
const { ManagementClient } = require('auth0'); // For Auth0 integration
require('dotenv').config();

const app = express();
const PORT = process.env.PORT || 3000;

// Middleware
app.use(bodyParser.json());

// Configure Auth0 Management API
const auth0 = new ManagementClient({
  domain: process.env.AUTH0_DOMAIN,
  clientId: process.env.AUTH0_CLIENT_ID,
  clientSecret: process.env.AUTH0_CLIENT_SECRET,
  scope: 'read:users update:users',
});

// Routes

// 1. Handle Multi-Organization Authentication
app.post('/organizations/:orgId/login', async (req, res) => {
  const { orgId } = req.params;
  const { email, password } = req.body;

  try {
    // Add your organization-specific login logic here
    res.status(200).json({ message: Login successful for organization ${orgId} });
  } catch (error) {
    res.status(500).json({ error: 'Organization login failed.', details: error.message });
  }
});

// 2. User Invitations
app.post('/users/invite', async (req, res) => {
  const { email } = req.body;

  try {
    // Example: Sending an invitation
    await auth0.createUser({
      connection: process.env.AUTH0_CONNECTION,
      email,
      password: 'Temporary@123', // You should generate and send a random password
      email_verified: false,
    });
    res.status(201).json({ message: Invitation sent to ${email} });
  } catch (error) {
    res.status(500).json({ error: 'Failed to send invitation.', details: error.message });
  }
});

// 3. Secure Integration with Auth0
app.get('/users', async (req, res) => {
  try {
    const users = await auth0.getUsers();
    res.status(200).json(users);
  } catch (error) {
    res.status(500).json({ error: 'Failed to fetch users.', details: error.message });
  }
});

// Start the Server
app.listen(PORT, () => {
  console.log(Ethera.js server is running on http://localhost:${PORT});
});
